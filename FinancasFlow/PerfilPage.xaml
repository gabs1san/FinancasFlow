<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:FinancasFlow.Components"
    x:Class="FinancasFlow.PerfilPage"
    Title="Perfil"
    BackgroundColor="#0B1F33"
    Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="*,Auto">

        <ScrollView
            Grid.Row="0">

            <VerticalStackLayout
                Padding="20"
                Spacing="15">

                <Label
                    Text="Perfil"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Aqui ficarão as informações do seu perfil."
                    FontSize="16"
                    TextColor="#8FA8BC" />

            </VerticalStackLayout>

        </ScrollView>

        <components:MenuNavegacao
            Grid.Row="1" />

    </Grid>

</ContentPage>