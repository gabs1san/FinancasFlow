<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.MainPage"
    Title="FinancasFlow"
    BackgroundColor="#0B1F33">

    <Grid
        RowDefinitions="Auto,*,Auto,Auto"
        Padding="0"
        RowSpacing="0">

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Grid
            Grid.Row="0"
            BackgroundColor="#102B46"
            Padding="15,12"
            ColumnDefinitions="Auto,*,Auto">

            <!-- BOTÃO VOLTAR -->

            <Label
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                TextColor="White"
                VerticalOptions="Center" />


            <!-- TÍTULO -->

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                HorizontalOptions="Center">

                <Label
                    Text="Finanças Flow"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />

                <Label
                    Text="Agente financeiro"
                    FontSize="11"
                    TextColor="#9DB6CC"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- NOVA CONVERSA -->

            <Label
                Grid.Column="2"
                Text="✎"
                FontSize="22"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>


        <!-- ========================= -->
        <!-- CHAT -->
        <!-- ========================= -->

        <Grid
            Grid.Row="1"
            BackgroundColor="#0B1F33">

            <ScrollView
                x:Name="ChatScrollView"
                VerticalOptions="Fill">

                <VerticalStackLayout
                    x:Name="ChatContainer"
                    Padding="15,15,15,20"
                    Spacing="15">

                    <Label
                        Text="Conversa"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />


                    <!-- AVISO DO RELATÓRIO -->

                    <Frame
                        BackgroundColor="#1C4164"
                        CornerRadius="8"
                        Padding="12,8"
                        HasShadow="False">

                        <Label
                            Text="Relatório Mensal em 7 dias 🗓️"
                            FontSize="13"
                            TextColor="White"
                            HorizontalOptions="Center" />

                    </Frame>


                    <!-- MENSAGEM INICIAL DO BOT -->

                    <Frame
                        BackgroundColor="#173750"
                        CornerRadius="12"
                        Padding="12"
                        HorizontalOptions="Start"
                        MaximumWidthRequest="320"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <HorizontalStackLayout
                                Spacing="6">

                                <Label
                                    Text="🤖"
                                    FontSize="16" />

                                <Label
                                    Text="FinFlow Assistant"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#72D6FF" />

                            </HorizontalStackLayout>

                            <Label
                                Text="Olá! 👋&#10;&#10;Sou seu agente financeiro pessoal. Pode me contar seus gastos, entradas ou perguntar sobre seu saldo."
                                FontSize="15"
                                TextColor="#E8F2F8" />

                        </VerticalStackLayout>

                    </Frame>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>


        <!-- ========================= -->
        <!-- ÁREA DE DIGITAÇÃO -->
        <!-- ========================= -->

        <Grid
            Grid.Row="2"
            BackgroundColor="#102B46"
            Padding="10,8"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="8">

            <!-- ÍCONE -->

            <Label
                Grid.Column="0"
                Text="📷"
                FontSize="20"
                VerticalOptions="Center"
                TextColor="#AFC6D8" />


            <!-- CAMPO -->

            <Border
                Grid.Column="1"
                BackgroundColor="#1B3B59"
                Stroke="#2A5577"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="12,0"
                HeightRequest="45">

                <Entry
                    x:Name="txtMensagem"
                    Placeholder="Digite uma mensagem..."
                    PlaceholderColor="#8FA8BC"
                    TextColor="White"
                    FontSize="15"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center" />

            </Border>


            <!-- MICROFONE -->

            <Label
                Grid.Column="2"
                Text="🎤"
                FontSize="20"
                VerticalOptions="Center"
                TextColor="#AFC6D8" />


            <!-- ENVIAR -->

            <Button
                Grid.Column="3"
                Text="➤"
                FontSize="20"
                TextColor="White"
                BackgroundColor="#2997D8"
                CornerRadius="23"
                WidthRequest="45"
                HeightRequest="45"
                Clicked="EnviarButton_Clicked" />

        </Grid>


        <!-- ========================= -->
        <!-- NAVEGAÇÃO -->
        <!-- ========================= -->

        <Grid
            Grid.Row="3"
            BackgroundColor="#102B46"
            Padding="10,8,10,12"
            ColumnDefinitions="*,*,*,*">


            <!-- ========================= -->
            <!-- INÍCIO -->
            <!-- ========================= -->

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="2"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="Inicio_Tapped" />

                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="⌂"
                    FontSize="25"
                    TextColor="#4DB8FF"
                    HorizontalOptions="Center" />

                <Label
                    Text="Início"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#4DB8FF"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- ========================= -->
            <!-- RESUMO -->
            <!-- ========================= -->

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="Resumo_Tapped" />

                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="▥"
                    FontSize="24"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

                <Label
                    Text="Resumo"
                    FontSize="11"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- ========================= -->
            <!-- ADICIONAR -->
            <!-- ========================= -->

            <VerticalStackLayout
                Grid.Column="2"
                Spacing="2"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="Adicionar_Tapped" />

                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="+"
                    FontSize="27"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

                <Label
                    Text="Adicionar"
                    FontSize="11"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- ========================= -->
            <!-- PERFIL -->
            <!-- ========================= -->

            <VerticalStackLayout
                Grid.Column="3"
                Spacing="2"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="Perfil_Tapped" />

                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="♙"
                    FontSize="25"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

                <Label
                    Text="Perfil"
                    FontSize="11"
                    TextColor="#8FA8BC"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>