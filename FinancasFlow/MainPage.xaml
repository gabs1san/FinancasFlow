<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:FinancasFlow.Components"
    x:Class="FinancasFlow.MainPage"
    Title="FinancasFlow"
    BackgroundColor="#0B1F33">

    <Grid
        RowDefinitions="Auto,*,Auto,Auto"
        Padding="0"
        RowSpacing="0">

        <!-- CABEÇALHO -->

        <Grid
            Grid.Row="0"
            BackgroundColor="#102B46"
            Padding="15,12"
            ColumnDefinitions="Auto,*,Auto">

            <Label
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                TextColor="White"
                VerticalOptions="Center" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                HorizontalOptions="Center">

                <Label
                    Text="Finanças Flow"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />

                <Label
                    Text="Agente financeiro"
                    FontSize="11"
                    TextColor="#9DB6CC"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

            <Label
                Grid.Column="2"
                Text="✎"
                FontSize="22"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>


        <!-- CHAT -->

        <Grid
            Grid.Row="1"
            BackgroundColor="#0B1F33">

            <ScrollView
                x:Name="ChatScrollView"
                VerticalOptions="Fill">

                <VerticalStackLayout
                    x:Name="ChatContainer"
                    Padding="15,15,15,20"
                    Spacing="15">

                    <Label
                        Text="Conversa"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Frame
                        BackgroundColor="#1C4164"
                        CornerRadius="8"
                        Padding="12,8"
                        HasShadow="False">

                        <Label
                            Text="Relatório Mensal em 7 dias 🗓️"
                            FontSize="13"
                            TextColor="White"
                            HorizontalOptions="Center" />

                    </Frame>

                    <Frame
                        BackgroundColor="#173750"
                        CornerRadius="12"
                        Padding="12"
                        HorizontalOptions="Start"
                        MaximumWidthRequest="320"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="5">

                            <HorizontalStackLayout
                                Spacing="6">

                                <Label
                                    Text="🤖"
                                    FontSize="16" />

                                <Label
                                    Text="FinFlow Assistant"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#72D6FF" />

                            </HorizontalStackLayout>

                            <Label
                                Text="Olá! 👋&#10;&#10;Sou seu agente financeiro pessoal. Pode me contar seus gastos, entradas ou perguntar sobre seu saldo."
                                FontSize="15"
                                TextColor="#E8F2F8" />

                        </VerticalStackLayout>

                    </Frame>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>


        <!-- DIGITAÇÃO -->

        <Grid
            Grid.Row="2"
            BackgroundColor="#102B46"
            Padding="10,8"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="8">

            <Label
                Grid.Column="0"
                Text="📷"
                FontSize="20"
                VerticalOptions="Center"
                TextColor="#AFC6D8" />

            <Border
                Grid.Column="1"
                BackgroundColor="#1B3B59"
                Stroke="#2A5577"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="12,0"
                HeightRequest="45">

                <Entry
                    x:Name="txtMensagem"
                    Placeholder="Digite uma mensagem..."
                    PlaceholderColor="#8FA8BC"
                    TextColor="White"
                    FontSize="15"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center" />

            </Border>

            <Label
                Grid.Column="2"
                Text="🎤"
                FontSize="20"
                VerticalOptions="Center"
                TextColor="#AFC6D8" />

            <Button
                Grid.Column="3"
                Text="➤"
                FontSize="20"
                TextColor="White"
                BackgroundColor="#2997D8"
                CornerRadius="23"
                WidthRequest="45"
                HeightRequest="45"
                Clicked="EnviarButton_Clicked" />

        </Grid>


        <!-- MENU -->

        <components:MenuNavegacao
            Grid.Row="3" />

    </Grid>

</ContentPage>