<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.Components.MenuNavegacao"
    BackgroundColor="#151515">

    <Grid
        x:Name="GridMenu"
        Padding="10,8,10,12"
        ColumnDefinitions="*,*,*,*"
        ColumnSpacing="6">

        <!-- Destaque móvel atrás dos ícones -->
        <Border
            x:Name="IndicadorSelecionado"
            Grid.Column="0"
            BackgroundColor="#332A1A"
            Stroke="#8D7133"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            InputTransparent="True"
            ZIndex="0" />

        <!-- INÍCIO -->
        <VerticalStackLayout
            x:Name="ItemInicio"
            Grid.Column="0"
            Spacing="3"
            Padding="6,8"
            HorizontalOptions="Fill"
            ZIndex="1">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Inicio_Tapped" />
            </VerticalStackLayout.GestureRecognizers>

            <Image
                Source="inicio.png"
                WidthRequest="26"
                HeightRequest="28"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                x:Name="TextoInicio"
                Text="Início"
                FontSize="11"
                FontAttributes="Bold"
                TextColor="#D8B866"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- RESUMO -->
        <VerticalStackLayout
            x:Name="ItemResumo"
            Grid.Column="1"
            Spacing="3"
            Padding="6,8"
            HorizontalOptions="Fill"
            ZIndex="1">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Resumo_Tapped" />
            </VerticalStackLayout.GestureRecognizers>

            <Image
                Source="resumo.png"
                WidthRequest="26"
                HeightRequest="28"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                x:Name="TextoResumo"
                Text="Resumo"
                FontSize="11"
                TextColor="#A99A78"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ADICIONAR -->
        <VerticalStackLayout
            x:Name="ItemAdicionar"
            Grid.Column="2"
            Spacing="3"
            Padding="6,8"
            HorizontalOptions="Fill"
            ZIndex="1">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Adicionar_Tapped" />
            </VerticalStackLayout.GestureRecognizers>

            <Image
                Source="adicionar.png"
                WidthRequest="26"
                HeightRequest="28"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                x:Name="TextoAdicionar"
                Text="Adicionar"
                FontSize="11"
                TextColor="#A99A78"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- PERFIL -->
        <VerticalStackLayout
            x:Name="ItemPerfil"
            Grid.Column="3"
            Spacing="3"
            Padding="6,8"
            HorizontalOptions="Fill"
            ZIndex="1">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Perfil_Tapped" />
            </VerticalStackLayout.GestureRecognizers>

            <Image
                Source="perfil.png"
                WidthRequest="26"
                HeightRequest="28"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                x:Name="TextoPerfil"
                Text="Perfil"
                FontSize="11"
                TextColor="#A99A78"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentView>
