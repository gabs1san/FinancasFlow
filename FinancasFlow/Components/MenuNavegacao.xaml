<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.Components.MenuNavegacao"
    BackgroundColor="#151515">

    <Grid
        Padding="10,8,10,12"
        ColumnDefinitions="*,*,*,*"
        ColumnSpacing="6">

        <!-- INÍCIO -->
        <Border
            x:Name="BordaInicio"
            Grid.Column="0"
            BackgroundColor="#332A1A"
            Stroke="#8D7133"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="6,8">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Inicio_Tapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout
                Spacing="3"
                HorizontalOptions="Center">

                <Image
                    Source="inicio.png"
                    WidthRequest="26"
                    HeightRequest="28"
                    Aspect="AspectFit" />

                <Label
                    x:Name="TextoInicio"
                    Text="Início"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#D8B866"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

        <!-- RESUMO -->
        <Border
            x:Name="BordaResumo"
            Grid.Column="1"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="6,8">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Resumo_Tapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout
                Spacing="3"
                HorizontalOptions="Center">

                <Image
                    Source="resumo.png"
                    WidthRequest="26"
                    HeightRequest="28"
                    Aspect="AspectFit" />

                <Label
                    x:Name="TextoResumo"
                    Text="Resumo"
                    FontSize="11"
                    TextColor="#A99A78"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

        <!-- ADICIONAR -->
        <Border
            x:Name="BordaAdicionar"
            Grid.Column="2"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="6,8">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Adicionar_Tapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout
                Spacing="3"
                HorizontalOptions="Center">

                <Image
                    Source="adicionar.png"
                    WidthRequest="26"
                    HeightRequest="28"
                    Aspect="AspectFit" />

                <Label
                    x:Name="TextoAdicionar"
                    Text="Adicionar"
                    FontSize="11"
                    TextColor="#A99A78"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

        <!-- PERFIL -->
        <Border
            x:Name="BordaPerfil"
            Grid.Column="3"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="6,8">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Perfil_Tapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout
                Spacing="3"
                HorizontalOptions="Center">

                <Image
                    Source="perfil.png"
                    WidthRequest="26"
                    HeightRequest="28"
                    Aspect="AspectFit" />

                <Label
                    x:Name="TextoPerfil"
                    Text="Perfil"
                    FontSize="11"
                    TextColor="#A99A78"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentView>
