<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.Views.Conteudos.AdicionarContent"
    BackgroundColor="#080808">

    <Grid RowDefinitions="Auto,*">


        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#151515"
            Padding="20,18">

            <VerticalStackLayout Spacing="3">
                <Label
                    Text="Adicionar lançamento"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#F5F5F5" />

                <Label
                    Text="Registre suas movimentações financeiras"
                    FontSize="12"
                    TextColor="#A99A78" />
            </VerticalStackLayout>

        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,20,20,25"
                Spacing="20">

                <!-- TIPO DE LANÇAMENTO -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Tipo de lançamento"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Border
                            x:Name="BordaDespesa"
                            Grid.Column="0"
                            BackgroundColor="#C9A34A"
                            Stroke="#C9A34A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">


                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Despesa_Tapped" />
                            </Border.GestureRecognizers>


                            <VerticalStackLayout
                                Spacing="5"
                                HorizontalOptions="Center">

                                <Label
                                    Text="↓"
                                    FontSize="25"
                                    TextColor="#17130A"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Despesa"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#17130A" />

                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="BordaEntrada"
                            Grid.Column="1"
                            BackgroundColor="#151515"
                            Stroke="#49402C"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Entrada_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="5"
                                HorizontalOptions="Center">

                                <Label
                                    Text="↑"
                                    FontSize="25"
                                    TextColor="#D8B866"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Entrada"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#D8B866" />

                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- VALOR -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Valor"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#8D7133"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15,5">

                        <Grid ColumnDefinitions="Auto,*">

                            <Label
                                Text="R$"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#D8B866"
                                VerticalOptions="Center" />

                            <Entry
                                x:Name="CampoValor"
                                Text="{Binding Valor, Mode=TwoWay}"
                                Grid.Column="1"
                                Placeholder="0,00"
                                PlaceholderColor="#81775F"
                                TextColor="#F5F5F5"
                                FontSize="24"
                                Keyboard="Numeric"
                                BackgroundColor="Transparent" />

                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- DESCRIÇÃO -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Descrição"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,2">

                        <Entry
                            x:Name="CampoDescricao"
                            Text="{Binding Descricao, Mode=TwoWay}"
                            Placeholder="Ex.: Compra no supermercado"
                            PlaceholderColor="#81775F"
                            TextColor="#F5F5F5"
                            BackgroundColor="Transparent" />

                    </Border>
                </VerticalStackLayout>

                <!-- CATEGORIA -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Categoria"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Picker
    x:Name="CampoCategoria"
    SelectedItem="{Binding Categoria, Mode=TwoWay}"
    Title="Selecionar categoria"
    TitleColor="#A99A78"
    TextColor="#F5F5F5"
    BackgroundColor="Transparent"
    SelectedIndex="-1">

                            <Picker.Items>
                                <x:String>Salário</x:String>
                                <x:String>Freelance</x:String>
                                <x:String>Investimentos</x:String>
                                <x:String>Alimentação</x:String>
                                <x:String>Transporte</x:String>
                                <x:String>Moradia</x:String>
                                <x:String>Saúde</x:String>
                                <x:String>Lazer</x:String>
                                <x:String>Outros</x:String>
                            </Picker.Items>

                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- FORMA DE PAGAMENTO -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Forma de pagamento"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Picker
    x:Name="CampoPagamento"
    SelectedItem="{Binding FormaPagamento, Mode=TwoWay}"
    Title="Selecionar pagamento"
    TitleColor="#A99A78"
    TextColor="#F5F5F5"
    BackgroundColor="Transparent"
    SelectedIndex="-1">

                            <Picker.Items>
                                <x:String>PIX</x:String>
                                <x:String>Dinheiro</x:String>
                                <x:String>Débito</x:String>
                                <x:String>Crédito</x:String>
                                <x:String>Transferência</x:String>
                            </Picker.Items>

                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- DATA -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="Data da movimentação"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <DatePicker
    x:Name="CampoData"
    Format="dd/MM/yyyy"
    TextColor="#F5F5F5"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    Date="{Binding Data, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>

                <!-- BOTÃO VISUAL -->
                <Button
                     x:Name="BotaoSalvar"
    Text="Salvar lançamento"
    Command="{Binding SalvarTransacaoCommand}"
    IsEnabled="{Binding PodeSalvar}"
    FontSize="15"
    FontAttributes="Bold"
    TextColor="#17130A"
    BackgroundColor="#C9A34A"
    CornerRadius="12"
    HeightRequest="52"
    Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>



    </Grid>
</ContentView>
