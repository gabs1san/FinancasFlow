<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.Views.Conteudos.ResumoContent"
    BackgroundColor="#080808">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="Resumo financeiro"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Label
                        Text="{Binding MesReferencia}"
                        FontSize="13"
                        TextColor="#A99A78" />

                </VerticalStackLayout>

                <Label
                    Grid.Column="1"
                    Text="◉"
                    FontSize="27"
                    TextColor="#D8B866"
                    VerticalOptions="Center" />

            </Grid>

            <!-- SALDO DISPONÍVEL -->
            <Border
                BackgroundColor="#211E18"
                Stroke="#8D7133"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Saldo disponível"
                            FontSize="14"
                            TextColor="#C8B58D" />

                        <Label
                            Grid.Column="1"
                            Text="◈"
                            FontSize="20"
                            TextColor="#D8B866" />

                    </Grid>

                    <Label
                        Text="{Binding Saldo}"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#D8B866" />

                    <Label
                        Text="Receitas − despesas pagas"
                        FontSize="12"
                        TextColor="#A99A78" />

                </VerticalStackLayout>
            </Border>

            <!-- RECEITAS E DESPESAS -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <!-- RECEITAS -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#1B1B1B"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="Receitas_Tapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="9">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Receitas"
                                FontSize="13"
                                TextColor="#A99A78" />

                            <Label
                                Grid.Column="1"
                                Text="↗"
                                FontSize="18"
                                TextColor="#4ADE80" />

                        </Grid>

                        <Label
                            Text="{Binding Receitas}"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#4ADE80"
                            LineBreakMode="TailTruncation" />

                        <Label
                            x:Name="TextoAcaoExtrato"
                            Text="Ver extrato"
                            FontSize="11"
                            TextColor="#D8B866" />

                    </VerticalStackLayout>
                </Border>

                <!-- DESPESAS -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#1B1B1B"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout Spacing="9">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Despesas"
                                FontSize="13"
                                TextColor="#A99A78" />

                            <Label
                                Grid.Column="1"
                                Text="↘"
                                FontSize="18"
                                TextColor="#F87171" />

                        </Grid>

                        <Label
                            Text="{Binding Despesas}"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#F87171"
                            LineBreakMode="TailTruncation" />

                        <Label
                            Text="Pagas no mês"
                            FontSize="11"
                            TextColor="#A99A78" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- EXTRATO DE RECEITAS -->
            <Border
                x:Name="PainelExtrato"
                IsVisible="False"
                BackgroundColor="#1B1B1B"
                Stroke="#49402C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Extrato de receitas"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Label
                        x:Name="MensagemSemReceitas"
                        Text="Nenhuma receita registrada neste mês."
                        TextColor="#A99A78"
                        FontSize="13"
                        IsVisible="False" />

                    <VerticalStackLayout
                        Spacing="8"
                        BindableLayout.ItemsSource="{Binding ExtratoReceitas}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10"
                                    Padding="0,10">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="4">

                                        <Label
                                            Text="{Binding Descricao}"
                                            TextColor="#F5F5F5"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Categoria}"
                                            TextColor="#D8B866"
                                            FontSize="12" />

                                        <Label
                                            Text="{Binding Data,
                                                StringFormat='{0:dd/MM/yyyy}'}"
                                            TextColor="#A99A78"
                                            FontSize="11" />

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Valor,
                                            StringFormat='+ R$ {0:N2}'}"
                                        TextColor="#4ADE80"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />

                                </Grid>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- CARTÃO DE CRÉDITO -->

            <!-- CARTÃO DE CRÉDITO -->
            <Border
    BackgroundColor="#1B1B1B"
    Stroke="#49402C"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 16"
    Padding="18">

                <VerticalStackLayout Spacing="15">

                    <!-- CABEÇALHO -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                Text="{Binding NomeCartao}"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="#F5F5F5" />

                        <Label
                Grid.Column="1"
                Text="▣"
                FontSize="23"
                TextColor="#D8B866" />

                    </Grid>

                    <!-- VALORES -->
                    <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="12">

                        <VerticalStackLayout Spacing="6">

                            <Label
                    Text="Compras no crédito"
                    FontSize="12"
                    TextColor="#A99A78" />

                            <Label
                    Text="{Binding FaturaCartao}"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#F5F5F5" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                Grid.Column="1"
                Spacing="6">

                            <Label
                    Text="Limite estimado"
                    FontSize="12"
                    TextColor="#A99A78" />

                            <Label
                    Text="{Binding LimiteCartao}"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#D8B866" />

                        </VerticalStackLayout>

                    </Grid>

                    <!-- BARRA DE UTILIZAÇÃO -->
                    <ProgressBar
            Progress="{Binding ProgressoCartao}"
            ProgressColor="#D8B866"
            BackgroundColor="#383838"
            HeightRequest="8" />

                    <!-- INFORMAÇÕES DO LIMITE -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                Text="{Binding PercentualCartao}"
                FontSize="11"
                TextColor="#A99A78" />

                        <HorizontalStackLayout
                Grid.Column="1"
                Spacing="4">

                            <Label
                    Text="Limite:"
                    FontSize="11"
                    TextColor="#A99A78" />

                            <Label
                    Text="{Binding LimiteTotalCartao}"
                    FontSize="11"
                    TextColor="#A99A78" />

                        </HorizontalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>


            <!-- DESPESAS POR PAGAMENTO -->
            <Border
                BackgroundColor="#1B1B1B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Despesas por pagamento"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <VerticalStackLayout
                        Spacing="18"
                        BindableLayout.ItemsSource="{Binding Pagamentos}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding Nome}"
                                            FontSize="14"
                                            TextColor="#F5F5F5" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Valor}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#F5F5F5" />

                                    </Grid>

                                    <ProgressBar
                                        Progress="{Binding Progresso}"
                                        ProgressColor="{Binding Cor}"
                                        BackgroundColor="#383838"
                                        HeightRequest="8" />

                                </VerticalStackLayout>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- DESPESAS POR CATEGORIA -->
            <Border
                BackgroundColor="#1B1B1B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Despesas por categoria"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#F5F5F5" />

                    <Label
                        x:Name="MensagemSemDespesas"
                        Text="Nenhuma despesa registrada neste mês."
                        TextColor="#A99A78"
                        FontSize="13"
                        IsVisible="False" />

                    <VerticalStackLayout
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding Categorias}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12"
                                    Padding="0,6">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Nome}"
                                        TextColor="#D8B866"
                                        FontSize="14" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Valor}"
                                        TextColor="#F5F5F5"
                                        FontSize="14"
                                        FontAttributes="Bold" />

                                </Grid>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#383838" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Total de despesas"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#F5F5F5" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Despesas}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#F87171" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
