<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinancasFlow.Views.Conteudos.PerfilContent"
    BackgroundColor="#080808">

    <Grid RowDefinitions="Auto,*">


        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#151515"
            Padding="20,18">

            <VerticalStackLayout Spacing="3">

                <Label
                    Text="Meu perfil"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#F5F5F5" />

                <Label
                    Text="Gerencie sua conta e suas preferências"
                    FontSize="12"
                    TextColor="#A99A78" />

            </VerticalStackLayout>
        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,20,20,25"
                Spacing="22">

                <!-- CARTÃO DO PERFIL -->
                <Border
                    BackgroundColor="#151515"
                    Stroke="#8D7133"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">

                    <VerticalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Border
                            WidthRequest="82"
                            HeightRequest="82"
                            BackgroundColor="#292215"
                            Stroke="#C9A34A"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"
                            HorizontalOptions="Center">

                            <Label
                                Text="♙"
                                FontSize="42"
                                TextColor="#D8B866"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Seu nome"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#F5F5F5"
                            HorizontalOptions="Center" />

                        <Label
                            Text="seuemail@email.com"
                            FontSize="13"
                            TextColor="#A99A78"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Editar perfil"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8B866"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <!-- MINHA CONTA -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="MINHA CONTA"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#D8B866" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="♙"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Dados pessoais"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#30291B"
                                Margin="0,8" />

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="◆"
                                    FontSize="19"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Segurança e privacidade"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- PREFERÊNCIAS -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="PREFERÊNCIAS"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#D8B866" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="♧"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Notificações"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#30291B"
                                Margin="0,8" />

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="☼"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Aparência"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#30291B"
                                Margin="0,8" />

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="◉"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Configurações financeiras"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SOBRE O APLICATIVO -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="SOBRE O APLICATIVO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#D8B866" />

                    <Border
                        BackgroundColor="#151515"
                        Stroke="#30291B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="ⓘ"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Sobre o Finanças Flow"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#30291B"
                                Margin="0,8" />

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">

                                <Label
                                    Text="▤"
                                    FontSize="21"
                                    TextColor="#C9A34A"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Termos e privacidade"
                                    FontSize="14"
                                    TextColor="#F5F5F5"
                                    Margin="12,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="23"
                                    TextColor="#A99A78"
                                    VerticalOptions="Center" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SAIR -->
                <Button
                    Text="Sair da conta"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#D98282"
                    BackgroundColor="#211414"
                    BorderColor="#593030"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="48" />

                <Label
                    Text="Finanças Flow • Versão 1.0"
                    FontSize="11"
                    TextColor="#777064"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

       

    </Grid>
</ContentView>
