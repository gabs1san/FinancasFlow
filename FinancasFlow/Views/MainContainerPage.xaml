<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:FinancasFlow.Components"
    x:Class="FinancasFlow.Views.MainContainerPage"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto"
          RowSpacing="0">

        <!-- Área dinâmica -->
        <ContentView
            x:Name="ContentArea"
            Grid.Row="0"
            BackgroundColor="#080808" />

        <!-- Menu inferior fixo -->
        <components:MenuNavegacao
    x:Name="MenuInferior"
    Grid.Row="1" />

    </Grid>

</ContentPage>
